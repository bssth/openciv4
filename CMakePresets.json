{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
	"configurePresets": [
		{
			"name": "vs2026",
			"displayName": "Visual Studio 2026 solution (x64)",
			"description": "Generates build/vs2026/openciv4.sln",
			"generator": "Visual Studio 18 2026",
			"architecture": { "value": "x64", "strategy": "set" },
			"binaryDir": "${sourceDir}/build/vs2026"
		},
		{
			"name": "vs2022",
			"displayName": "Visual Studio 2022 solution (x64)",
			"description": "Generates build/vs2022/openciv4.sln",
			"generator": "Visual Studio 17 2022",
			"architecture": { "value": "x64", "strategy": "set" },
			"binaryDir": "${sourceDir}/build/vs2022"
		},
		{
			"name": "ninja-base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"architecture": { "value": "x64", "strategy": "external" },
			"condition": {
				"type": "inList",
				"string": "$env{VSCMD_ARG_TGT_ARCH}",
				"list": [ "x64", "" ]
			}
		},
		{
			"name": "ninja-cl",
			"hidden": true,
			"inherits": "ninja-base",
			"cacheVariables":
			{ 
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "release",
			"displayName": "Ninja Release (x64, MSVC, run from a VS x64 developer prompt)",
			"inherits": "ninja-cl",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "debug",
			"displayName": "Ninja Debug (x64, MSVC, run from a VS x64 developer prompt)",
			"inherits": "ninja-cl",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "ninja-clang-cl",
			"hidden": true,
			"inherits": "ninja-base",
			"cacheVariables":
			{
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "release-clang-cl",
			"displayName": "Ninja Release (x64, clang-cl, run from a VS x64 developer prompt)",
			"inherits": "ninja-clang-cl",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "debug-clang-cl",
			"displayName": "Ninja Debug (x64, clang-cl, run from a VS x64 developer prompt)",
			"inherits": "ninja-clang-cl",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		}
	],
	"buildPresets": [
		{ "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
		{ "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
		{ "name": "release", "configurePreset": "release" },
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "release-clang-cl", "configurePreset": "release-clang-cl" },
		{ "name": "debug-clang-cl", "configurePreset": "debug-clang-cl" }
	]
}
