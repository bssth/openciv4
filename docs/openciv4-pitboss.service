# User service: edit paths, then copy to ~/.config/systemd/user/.
[Unit]
Description=OpenCiv4 PitBoss dedicated game server
After=network.target

[Service]
Type=simple
ExecStart=%h/git/openciv4/build/linux-headless/bin/oc4core --pitboss %h/.config/openciv4/pitboss.ini
Environment=OC4_DOCUMENTS=%h/.local/state/openciv4/pitboss/documents
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
